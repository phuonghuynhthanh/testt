DATABASE_DRIVER=postgresql
DATABASE_HOST=localhost
DATABASE_NAME=quantvn
DATABASE_PASSWORD=quantvn
DATABASE_PORT=5432
DATABASE_USERNAME=quantvn

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cms-media
MINIO_SECURE=false
MINIO_REGION=
MINIO_AUTO_CREATE_BUCKET=true
MEDIA_MAX_UPLOAD_MB=10

ADMIN_USERNAME=
# Optional profile fields fall back to ADMIN_USERNAME when empty.
ADMIN_DISPLAY_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate limits are per IP and endpoint; WRITE covers uploads and blog/post saves, AI covers AI and publishing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_WRITE=30/minute
# Enable only when a controlled proxy overwrites X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=false
# memory:// is valid for one worker only; use redis://... before adding workers or replicas.
RATE_LIMIT_STORAGE_URI=memory://

GEMINI_API_KEY=
GEMINI_MODEL=

DOMAIN_URL=http://localhost:5173
AUTHOR=Quantvn

ALLOWED_ORIGINS=http://localhost:5173

SERP_API_KEY=
SERP_API_PROVIDER=serpapi
SERP_RATE_LIMIT_PER_MINUTE=10
SERP_RATE_LIMIT_PER_DAY=1000
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_VERSION=
PEXELS_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
